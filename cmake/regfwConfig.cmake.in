@PACKAGE_INIT@
if(POLICY CMP0144)
  cmake_policy(SET CMP0144 NEW)
endif()
include(CMakeFindDependencyMacro)
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(HLog MODULE)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/regfwTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/RegfwPch.cmake")
check_required_components(regfw)
